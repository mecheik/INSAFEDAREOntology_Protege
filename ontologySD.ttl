###  http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/TradeOffBetweenQualityAndPrivacy-QPS
:TradeOffBetweenQualityAndPrivacy-QPS rdf:type owl:NamedIndividual ,
                                               :PrivacyMetrics ;
                                      :HasModality :TabularData ;
