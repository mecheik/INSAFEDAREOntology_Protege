:PhishingAndSocialEngineering rdf:type owl:NamedIndividual ,
                                       :DataSecurityAndPrivacy ;
                              :HasConsequence <http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD#CompromisedPatientData;ServiceDisruption> ;
                              :HasDetectability :LowDetectability ;
                              :HasLikelihood :HighLikelihood ;
