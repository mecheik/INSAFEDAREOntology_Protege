         :ApplicableToTypesOfValues "Local Identifiers" ;
         :DataTruthfulnessAtRecordLevel "YES" ;
         :ReducesRiskOfInference "No" ;
         :ReducesRiskOfLinking "Partially" ;
         :ReducesRiskOfSinglingout "Yes" .


