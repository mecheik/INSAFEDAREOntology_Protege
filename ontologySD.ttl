#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD#BenchmarkThresholds
:BenchmarkThresholds rdf:type owl:Class ;
                     rdfs:subClassOf :ComplianceControl .


###  http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD#PrivacyModels
:PrivacyModels rdf:type owl:Class ;
               rdfs:subClassOf :DeIdentificationTechniques .


###  http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD#RiskAssessment
:RiskAssessment rdf:type owl:Class ;
                rdfs:subClassOf :ComplianceControl .


###  http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD#AssuranceCaseWorkingGroup(ACWG)
<http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD#AssuranceCaseWorkingGroup(ACWG)> rdf:type owl:Class ;
                                                                                                   rdfs:subClassOf :AssuranceCaseRegulations ;
                                                                                                   rdfs:comment """The Goal Structuring Notation Standard Working Group (GSN_SWG) members include: 

experienced practitioners, who have used and continue to use GSN on major projects; 
academics and industry specialists, who have researched and developed the theory and principles behind the notation;
tool vendors, who have supported the realisation of tool support for the notation;
liaison with the organisation responsible for publication of the Structured Assurance Case Metamodel (SACM).""" .


###  http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/AccessIsControlledEvidence
:AccessIsControlledEvidence rdf:type owl:Class ;
