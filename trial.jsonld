  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/BandwidthAndResourceAllocationIssues",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/DataTransmissionAndSharing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Bandwidth limitations and improper resource allocation can lead to significant delays in data transmission, which is particularly critical in healthcare. Several studies indicate that insufficient bandwidth can prevent timely data access, particularly in high-demand situations such as emergency care. These issues typically arise when network demand exceeds available bandwidth, leading to delays or dropped connections, which can impact critical care decisions. Implementing Quality of Service controls and network traffic shaping are effective strategies for managing bandwidth and ensuring timely data delivery."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/BaselineComparison",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
