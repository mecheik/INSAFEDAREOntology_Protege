  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/GuidelinesForTrustworthyAI",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/lastUpdated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2019-04-08"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "According to the Guidelines, trustworthy AI should be:\n\n(1) lawful -  respecting all applicable laws and regulations\n\n(2) ethical - respecting ethical principles and values\n\n(3) robust - both from a technical perspective while taking into account its social environment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/EUEthics"
