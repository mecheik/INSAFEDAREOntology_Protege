}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PractiseGuideForRobustAndResilientEUHealthSector",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/lastUpdated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2025-09-16"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The ongoing digital transformation of healthcare services and providers across the EU has increased complexity and interconnectedness in the sector, while introducing new cybersecurity risks. Medical systems and data have become growing targets of cybercrime, with ransomware and phishing campaigns on the rise. According to ENISA’s NIS360 report, the health sector is classified among those in the risk zone, highlighting a significant gap between its cybersecurity maturity and its critical importance. The report calls for further guidance and support to strengthen resilience across the sector."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/ENISAReport"
  } ]
