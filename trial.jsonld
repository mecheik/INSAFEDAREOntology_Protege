}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/ComplianceFailure",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/DataSecurityAndPrivacy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Compliance failure occurs when healthcare organizations fail to adhere to relevant data protection laws and regulations, such as HIPAA or GDPR, often due to oversight or lack of resources. Literature identifies causes such as inadequate resource allocation, insufficient understanding of regulations, and flawed documentation. The consequences include legal penalties, operational disruptions, and loss of patient trust. Mitigation strategies involve regular compliance audits and maintaining thorough documentation of compliance activities."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/Consequences",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
