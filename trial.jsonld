}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/UnauthorizedAccess",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/DataSecurityAndPrivacy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Unauthorized access involves individuals or entities gaining unauthorized access to sensitive patient data, often due to weak security measures, insider threats, or unintentional actions such as leaving systems unattended. This can lead to breaches of confidentiality and identity theft. Several sources of such breaches are highlighted in the literature, including weak passwords, inadequate access controls, and insider threats. The consequences can be severe, including breaches of patient confidentiality, identity theft, and legal implications. Mitigation strategies include implementing multi-factor authentication (MFA), regularly updating access controls, and conducting background checks on employees to prevent unauthorized access."
  } ]
}, {
