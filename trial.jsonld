}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/FDA21CFRPart11",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/lastUpdated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2003-09-01"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "This guidance is intended to describe the Food and Drug Administration's (FDA's) current thinking regarding the scope and application of part 11 of Title 21 of the Code of Federal Regulations; Electronic Records; Electronic Signatures (21 CFR Part 11).2\n\nThis document provides guidance to persons who, in fulfillment of a requirement in a statute or another part of FDA's regulations to maintain records or submit information to FDA3, have chosen to maintain the records or submit designated information electronically and, as a result, have become subject to part 11. Part 11 applies to records in electronic form that are created, modified, maintained, archived, retrieved, or transmitted under any records requirements set forth in Agency regulations. Part 11 also applies to electronic records submitted to the Agency under the Federal Food, Drug, and Cosmetic Act (the Act) and the Public Health Service Act (the PHS Act), even if such records are not specifically identified in Agency regulations (§ 11.1). The underlying requirements set forth in the Act, PHS Act, and FDA regulations (other than part 11) are referred to in this guidance document as predicate rules."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/FDARegulations"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/FDA21CFRPart11Standard",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/FDA21CFRPart11"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/FDA21CFRPart820_QualitySystemRegulation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/lastUpdated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-01-31"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Manufacturers must establish and follow quality systems to help ensure that their products consistently meet applicable requirements and specifications. The quality systems for FDA-regulated products (food, drugs, biologics, and devices) are known as current good manufacturing practices (CGMP’s). CGMP requirements for devices in part 820 (21 CFR part 820) were first authorized by section 520(f) of the Federal Food, Drug, and Cosmetic Act (the Act).  Under section 520(f) of the Act, FDA issued a final rule in the Federal Register of July 21, 1978 (43 FR 31 508), prescribing CGMP requirements for medical devices. This regulation became effective on December 18, 1978, and was codified under part 820."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/FDARegulations"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/FDA21CFRPart820_QualitySystemRegulationStandard",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/FDA21CFRPart820_QualitySystemRegulation"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/FDARegulations",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/RegulatoryBody"
