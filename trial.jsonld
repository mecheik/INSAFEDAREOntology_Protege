}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/EMI-RFIAndTemperatureExtremes",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/EnvironmentalFactorsInDataHazardsModes"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Electromagnetic interference (EMI), radio frequency interference (RFI), and extreme temperatures can significantly impact the reliability and performance of healthcare IT systems, potentially leading to data corruption and hardware failures. EMI and RFI often originate from nearby electronic devices or industrial equipment, while temperature extremes may result from inadequate environmental controls. These factors can cause data errors, hardware malfunctions, and system shutdowns. Mitigation strategies include shielding critical equipment from interference, maintaining stable environmental conditions, and using redundant cooling systems to prevent overheating, thereby ensuring IT infrastructure reliability and preserving data integrity."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/ENISAReport",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The European Union Agency for Cybersecurity, ENISA, is the Union’s agency dedicated to achieving a high common level of cybersecurity across Europe. Established in 2004 and strengthened by the EU Cybersecurity Act, the European Union Agency for Cybersecurity contributes to EU cyber policy, enhances the trustworthiness of ICT products, services and processes with cybersecurity certification schemes, cooperates with Member States and EU bodies, and helps Europe prepare for the cyber challenges of tomorrow. Through knowledge sharing, capacity building and awareness raising, the Agency works together with its key stakeholders to strengthen trust in the connected economy, to boost resilience of the Union’s infrastructure, and, ultimately, to keep Europe’s society and citizens digitally secure. More information about ENISA and its work can be found here: www.enisa.europa.eu."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/RegulatoryBody"
  } ]
