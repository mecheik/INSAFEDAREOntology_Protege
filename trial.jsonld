  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PersonalDataEvidence",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/SecurityAndPrivacyEvidence"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PhishingAndSocialEngineering",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/DataSecurityAndPrivacy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Phishing and social engineering involve deceptive methods to trick individuals into disclosing sensitive information, thereby compromising the security of healthcare data. Existing studies indicate that phishing attacks are often enabled by a lack of user awareness and inadequate security measures for email communications. The consequences include compromised patient data and privacy, disruption of healthcare services, and regulatory non-compliance. Mitigation strategies include deploying anti-phishing technologies, implementing MFA methods, and establishing incident response plans to monitor and prevent unauthorized disclosures."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PhysicalSecurityBreaches",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/EnvironmentalFactorsInDataHazardsModes"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Physical security breaches occur when unauthorized individuals gain access to data storage facilities or devices, potentially leading to data theft, tampering, or system compromise. Causes include insufficient physical security measures, such as inadequate surveillance or a lack of access controls. The consequences may consist of data loss, unauthorized access to data, and compromised system integrity. Mitigation strategies include enhancing physical security with biometric access controls, surveillance systems, secure storage for sensitive equipment, and regular security audits to detect and address vulnerabilities."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PoisonedDataDectionTools",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/MitigationDataPoisoningAttacksContext"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PoisonedDataDectionToolsContext",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PoisonedDataDectionTools"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Tools for poisoned data detection & secure data pipelines are deployed."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PoisonedDataDetectionLog",
