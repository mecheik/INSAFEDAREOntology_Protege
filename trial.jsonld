}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/CorruptedDataWhileMaintainingAccuracy",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/RobustenessTestingAgainstNoisyInputsJustification"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/CorruptedDataWhileMaintainingAccuracyJustification",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/CorruptedDataWhileMaintainingAccuracy"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Demonstrates the model’s capacity to handle partial or corrupted data while maintaining accuracy"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/CryptographicSigningKeys",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/UpdateProcessedEvidence"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/CryptographicSigningKeysLog",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/CryptographicSigningKeys"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/CyberAttacks",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/EnvironmentalFactorsInDataHazardsModes"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Cyber-attacks, including malware, ransomware, and denial-of-service (DoS) attacks, pose significant threats to healthcare data security. These attacks are often launched by external actors aiming to exploit system vulnerabilities, disrupting operations, compromising patient data, and causing financial losses. Causes include weak cybersecurity measures, unpatched software, and phishing vulnerabilities. The consequences involve data breaches, service outages, and costly recovery efforts. Mitigation strategies focus on deploying advanced security measures, ensuring regular software updates, training employees on phishing risks, and establishing incident response plans to quickly address and contain attacks. Concretely, there is a need to apply threat modelling (e.g., STRIDE/attack trees), secure SDLC and code review, SBOM creation and maintenance, continuous vulnerability identification and remediation (patching/update mechanisms), security logging and anomaly detection, incident response and coordinated vulnerability disclosure, and postdeployment monitoring. This ensures that ransomware, DoS, and supply-chain threats are addressed through controls that meet health-sector cybersecurity expectations across pre-market and post-market phases."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/CyberSecurityAndResilienceForSmartHospitals",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/lastUpdated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2016-11-16"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "This study proposes key recommendations for hospital information security executives and industry to enhance the level of information security in Smart Hospitals. Through the identification of assets and the related threats when IoT components are supporting a healthcare organisation the report described the Smart Hospital ecosystem and its specific objectives. Based on the analysis of documents and empirical data, and the detailed examination of attack scenarios found to be particularly relevant for smart hospitals, this document identifies mitigation techniques and good practices.”"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/ENISAReport"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/CyberSecurityAndResilienceForSmartHospitalsStandard",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/CyberSecurityAndResilienceForSmartHospitals"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/CyberSecurityInMedicalDevices",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/lastUpdated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2025-06-27"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "With the increasing integration of wireless, Internet- and network-connected capabilities, portable media (e.g., USB or CD), and the frequent electronic exchange of medical devicerelated health information and other information, the need for robust cybersecurity controls to ensure medical device safety and effectiveness has become more important. In addition, cybersecurity threats to the healthcare sector have become more frequent and more severe, carrying increased potential for clinical impact. Cyber incidents have rendered medical devices and hospital networks inoperable, disrupting the delivery of patient care across healthcare facilities in the U.S. and globally. Such cyber incidents and exploits may lead to patient harm as a result of clinical hazards, such as delay in diagnoses and/or treatment. Increased connectivity has resulted in individual devices operating as single elements of larger medical device systems. These systems can include healthcare facility networks, other devices, and software update servers, among other interconnected components. Consequently, without\nadequate cybersecurity considerations across all aspects of these systems, a cybersecurity threat can compromise the safety and/or effectiveness of a device by compromising the functionality of any asset in the system. As a result, ensuring device safety and effectiveness includes adequate device cybersecurity, as well as its security as part of the larger system."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/FDARegulations"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/CyberSecurityInMedicalDevicesStandard",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/CyberSecurityInMedicalDevices"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/CybersecurityFramework2.0",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/lastUpdated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-02-26"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The NIST Cybersecurity Framework (CSF) 2.0 provides guidance to industry, government\nagencies, and other organizations to manage cybersecurity risks. It offers a taxonomy of highlevel cybersecurity outcomes that can be used by any organization — regardless of its size,\nsector, or maturity — to better understand, assess, prioritize, and communicate its\ncybersecurity efforts. The CSF does not prescribe how outcomes should be achieved. Rather, it\nlinks to online resources that provide additional guidance on practices and controls that could\nbe used to achieve those outcomes. This document describes CSF 2.0, its components, and\nsome of the many ways that it can be used."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/NIST"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/CybersecurityFramework2.0Standard",
