  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/DataUseInterpretation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Contextual misalignment occurs when data is used without proper consideration of the clinical context, resulting in decisions that may not be suitable for the patient’s specific circumstances. Studies indicate that lack of contextual information, overgeneralization, and a one-size-fits-all approach can result in inappropriate treatments and increased risk of adverse events. Strategies to prevent these misalignment issues include training in contextual awareness, employing integrated data systems that provide a holistic view of patient information, and developing tailored decision support tools."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/ContinuousExplainabilityValidation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/ModelBased"
