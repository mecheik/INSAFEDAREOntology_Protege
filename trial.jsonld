  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/Art15"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/Art22",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Right of access by the data subject."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/GDPR"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/Art22Standard",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/Art22"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/Art25",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Specifies the requirements for data protection by default: 'The controller shall implement appropriate technical and organisational measures for ensuring that, by default, only personal data which are necessary for each specific purpose of the processing are processed."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/GDPR"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/Art32",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The controller and processor shall take steps to ensure that any natural person acting under the authority of the controller or the processor who has access to personal data does not process them except on instructions from the controller, unless he or she is required to do so by Union or Member State law."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/GDPR"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/Art33",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "In the case of a personal data breach, the controller shall without undue delay and, where feasible, not later than 72 hours after having become aware of it, notify the personal data breach to, unless the personal data breach is unlikely to result in a risk to the rights and freedoms of natural ."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/GDPR"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/Art5",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Personal data shall be: (a)processed lawfully, fairly and in a transparent manner in relation to the data subject ('lawfulness, fairness and transparency')."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/GDPR"
  } ]
}, {
