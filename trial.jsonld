  }, {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/ThreatLandscapeHealthcareSectorStandard"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/DefenceMechanisms"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/DefenceMechanismsEvaluations",
