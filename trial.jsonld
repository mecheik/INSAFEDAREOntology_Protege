}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/HealthLevel7",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "HL7 messages are used to transfer data between various healthcare systems. These messages come in different types, each serving a unique purpose. Common HL7 message types include ADT (Admit, Discharge, Transfer), ORM (Order Entry), and ORU (Observation Result)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
