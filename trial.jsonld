}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/AlgorithmicBias",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/RegulatedBy" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/AequitasFramework"
  }, {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/FairlearnFramework"
  }, {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/IBMAIFairness360Framework"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/DataProcessingAndAnalysis"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Algorithmic bias occurs when data processing models produce skewed outcomes due to unbalanced training data, flawed model design, or cultural biases embedded in the data. Such biases can lead to unfair treatment recommendations, particularly affecting underrepresented groups. Several studies indicate that causes include biased training data, flawed model design, and inappropriate imputation techniques. Consequences include disparities in healthcare outcomes and loss of trust in data-driven systems. Mitigation techniques involve conducting bias audits, ensuring fairness in model design, and carefully selecting imputation methods to avoid reinforcing biases. Bias detection frameworks such as Fairlearn, Aequitas, or IBM AI Fairness 360 should be integrated to evaluate fairness metrics during development and deployment phases continuously."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/AlgorithmicBiasHazard",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/RegulatedBy" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/AequitasFramework"
  }, {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/FairlearnFramework"
  }, {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/IBMAIFairness360Framework"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/AligmentOnManagement",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
