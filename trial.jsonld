  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Environmental factors, encompassing external conditions and events, significantly impact the integrity, availability, and security of healthcare data systems. These hazards include system outages, cyber-attacks, physical security breaches, supply chain disruptions, and environmental interferences such as electromagnetic interference (EMI) and temperature extremes. These can lead to data loss, system downtime, and compromised patient care. Addressing these risks requires robust infrastructure, disaster recovery plans, and proactive security measures to ensure healthcare systems remain resilient against external disruptions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/HazardModes"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/EnvironmentalFactorsInDataHazardsModesCauses",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PotentialCauses"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/EssentialPrinciplesofSafetyandPerformanceofMedicalDevicesandIVDMedicalDevices",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/lastUpdated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2024-04-26"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The purpose of this IMDRF guidance is to provide harmonized Essential Principles that should be fulfilled in the design and manufacturing of medical devices and in vitro diagnostic (IVD) medical devices to ensure that they are safe and perform as intended."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/IMDRF"
