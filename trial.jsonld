}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/OverfittingAndUnderfittingOfModels",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/DataProcessingAndAnalysis"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Overfitting occurs when models are too closely tailored to training data, while underfitting happens when models fail to capture underlying patterns. Both lead to poor generalization and inaccurate predictions when applied to new data. Literature indicates that overfitting is caused by overly complex models, data leakage, or excessive model tuning, while underfitting results from overly simplistic models. Consequences include unreliable predictions and potential harm to patients. Mitigation strategies include simplifying models, employing balanced datasets, and using cross-validation techniques to enhance model generalization."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/OverrelianceOnData",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/DataUseInterpretation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Overreliance on data refers to the excessive trust placed in data-driven insights, sometimes at the expense of clinical expertise and patient-specific factors, which can lead to suboptimal healthcare decisions. Literature highlights that high confidence in algorithms, organizational pressure, and lack of alternative information can result in inappropriate clinical decisions and neglect of patient preferences. Mitigation strategies involve balanced decision-making, clinical decision support systems that integrate data with clinical guidelines, and providing technical support and education to healthcare professionals on combining data with clinical judgment."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/OwenershipAndAccountability",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/GovernanceAndComplianceContext"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/OwenershipAndAccountabilityContext",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/OwenershipAndAccountability"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Establishes clear ownership and accountability for data across the org."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PIICompilcationWithLaws",
