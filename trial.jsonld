}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PrivacyAct1998",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/RegulatoryBody"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PrivacyAct1998Standard",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PrivacyAct1998"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The Privacy Act 1988 was introduced to promote and protect the privacy of individuals and to regulate how Australian Government agencies and organisations with an annual turnover of more than $3 million, and some other organisations, handle personal information.\nThe Privacy Act includes 13 Australian Privacy Principles (APPs), which apply to some private sector organisations, as well as most Australian Government agencies. Such organisations and agencies are collectively known as ‘APP entities’. The Privacy Act also regulates the privacy component of the consumer credit reporting system, tax file numbers, and health and medical research."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PrivacyAndSecurityConcernsDuringDataCollection",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/HasConsequence" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD#LossOfTrust;LegalRepercussions"
  } ],
  "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/HasDetectability" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/LowDetectability"
  } ],
  "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/HasLikelihood" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/HighLikelihood"
  } ],
  "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/HasPotentialCause" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD#UnauthorizedAccess;InadequateSecurityMeasures"
  } ],
  "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/HasSeverity" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/HighSeverity"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/DataEntryAndCollection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Data entry systems must be secure to protect patient privacy. Unauthorized access, lack of audit logs, and the use of unsecured devices can lead to breaches of sensitive information. Studies on healthcare data security highlight the risks posed by inadequate security measures, emphasizing that privacy breaches can undermine patient trust and lead to legal and financial repercussions for healthcare providers.\n\nThe impact of breaches in privacy and security can be very high, leading to loss of patient trust, legal repercussions, and significant financial costs due to penalties and remediation efforts. As reported by Obot Affia et al., health devices must ensure the integrity of the data transmitted and received, as incorrect data can lead to life-threatening situations, which underscores the severity and challenges of detecting privacy breaches. The likelihood of these risks is high, as the increasing digitization of healthcare data and use of IoT devices expands the attack surface for cyber threats. Detecting breaches can be difficult, especially when sophisticated malware or insider threats are involved. As mentioned by Francisco et al. in terms of detecting breaches and the sophistication involved, the potential for insider threats and human errors cannot be overlooked. Continuous monitoring and advanced security protocols are necessary to promptly identify and mitigate such risks."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PrivacyNotices",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PersonalDataEvidence"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PrivacyNoticesLog",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/PrivacyNotices"
