}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/ThreatLandscapeHealthcareSector",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/lastUpdated" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2023-07-05"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "This is the first ENISA threat landscape report which brings insights into cyber threats targeting the European health sector. The sector was selected due to its criticality and its importance to European citizens and their well-being. In the ENISA Threat Landscape 20221, around 7% of the observed incidents targeted health organisations. Moreover, 32% of the incidents with a significant impact reported under the Network and Information Security Directive in 20223 were incidents in the EU health sector. Additionally, during 12 consecutive years the healthcare industry had the highest average cost of a breach worldwide. In this report, we have analysed cyber incidents targeting the health sector from January 2021 to March 2023. This period is referred to as the ’reporting period’ throughout the report. We collected publicly reported cyber incidents affecting various types of organisations related to health. \nThese include:\n• healthcare providers, such as hospitals, primary care providers, sociosanitary care providers, dental care providers, emergency services, mental health institutions, etc.,\n• EU reference laboratories, entities carrying out research and development activities for medicinal products and, more generally, organisations conducting health related research, \n• entities manufacturing basic pharmaceutical products and pharmaceutical preparations, and the pharmaceutical industry in general,\n• entities manufacturing medical devices and biotechnology manufacturers,\n• health authorities, bodies and agencies nationally and in the EU,\n• health insurance organisations,\n• residential treatment facilities and social services providers"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/ENISAReport"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/ThreatLandscapeHealthcareSectorStandard",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/ek279783/ontologies/2025/8/ontologySD/ThreatLandscapeHealthcareSector"
  } ]
